# Secret Chamber — Part 2 secrets
# Copy to .env and fill in, then push with:
#   supabase secrets set --env-file .env
# Never commit the filled-in .env file.

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=secret-chamber-blobs

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into every
# Edge Function by the Supabase platform — do NOT set them manually here.
